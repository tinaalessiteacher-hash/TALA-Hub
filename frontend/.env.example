# Public build-time setting, NOT a secret. Copy to .env.local if needed.
# true: clearly labeled frontend demo. false: account/data services unavailable.
# No real API adapter is implemented. Changing this flag never enables live auth.
VITE_DEMO_MODE=true
# Opt-in local QA controls (simulated errors and loading states). Keep off for demos.
VITE_DEMO_TOOLS=false
# Never place private SkipCourse credentials, passwords, or tokens in VITE_*.
# NEEDS_CONFIRMATION: real endpoint, auth and provisioning contracts from Karl.
